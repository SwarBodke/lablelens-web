# REQUIRED for stable signed sessions across server restarts. Generate a long random value.
LABLELENS_SECRET=replace-with-a-long-random-secret

# OCR language packs installed on the host. Dockerfile installs eng + hin.
LABLELENS_OCR_LANGS=eng+hin

# Guest workspace limits / retention.
GUEST_SCAN_LIMIT=20
GUEST_RETENTION_HOURS=24

# Optional explicit project-only reviewer mode. This is NOT government identity verification.
ALLOW_DEMO_REVIEWER=false
DEMO_REVIEWER_CODE=

# Evidence and persistence paths.
PRESERVE_EVIDENCE=true
SQLITE_PATH=./lablelens_history.db
EVIDENCE_DIR=./evidence

# Optional production DB (if set, PostgreSQL is used).
# DATABASE_URL=postgresql://user:password@host:5432/lablelens

# Comma-separated browser origins if frontend/API are hosted separately.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# OCR routing: adaptive | ensemble | rapid_first | rapid_only | tesseract_only
# adaptive is production default: fast Tesseract -> targeted Tesseract -> RapidOCR only if needed.
LABLELENS_OCR_MODE=adaptive
LABLELENS_TESSERACT_FAST_CONFIDENCE_THRESHOLD=86
LABLELENS_TESSERACT_FAST_COVERAGE_THRESHOLD=0.86
LABLELENS_TESSERACT_MIN_CHARS=55
LABLELENS_OCR_ACCURACY_GUARD=true
LABLELENS_RAPID_CONFIDENCE_THRESHOLD=80
LABLELENS_RAPID_COVERAGE_THRESHOLD=0.80
LABLELENS_TESSERACT_TIMEOUT_SEC=8

# Optional deployment-configured staff access. These are prototype access codes,
# not government identity verification. Use strong unique values and set LABLELENS_SECRET.
ALLOW_DEMO_OFFICER=false
DEMO_OFFICER_CODE=
DEMO_OFFICER_ID=officer-demo
DEMO_OFFICER_LABEL=Demo officer

ALLOW_DEMO_ADMIN=false
DEMO_ADMIN_CODE=
DEMO_ADMIN_ID=admin-demo
DEMO_ADMIN_LABEL=Demo administrator

# Google Sign-In for staff. Create a Web application OAuth client in Google Cloud.
# The browser receives a Google ID token; FastAPI verifies it and assigns the role
# from these allowlists. Never grant roles from frontend input.
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_EMAILS=admin@example.com
GOOGLE_OFFICER_EMAILS=officer1@example.com,officer2@example.com
# Optional Google Workspace domain-wide role mapping. Leave blank for exact-email-only access.
GOOGLE_ADMIN_DOMAINS=
GOOGLE_OFFICER_DOMAINS=
